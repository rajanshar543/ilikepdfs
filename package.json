    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run vendor && vite build",
        "dev": "vite",
        "vendor": "rm -rf public/vendor && mkdir -p public/vendor/pdfjs public/vendor/tesseract/core public/vendor/tesseract/lang && cp -R node_modules/pdfjs-dist/cmaps node_modules/pdfjs-dist/standard_fonts node_modules/pdfjs-dist/wasm node_modules/pdfjs-dist/iccs public/vendor/pdfjs/ && cp node_modules/tesseract.js/dist/worker.min.js public/vendor/tesseract/ && cp node_modules/tesseract.js-core/tesseract-core-lstm.wasm.js node_modules/tesseract.js-core/tesseract-core-simd-lstm.wasm.js node_modules/tesseract.js-core/tesseract-core-relaxedsimd-lstm.wasm.js public/vendor/tesseract/core/ && cp node_modules/@tesseract.js-data/*/4.0.0_best_int/*.traineddata.gz public/vendor/tesseract/lang/",
        "test": "vitest run",
        "e2e": "node tests/e2e/run.mjs"
    },
